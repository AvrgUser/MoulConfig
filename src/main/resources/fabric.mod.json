{
    "schemaVersion": 1,
    "id": "moulconfig",
    "version": "5.0.0",
    "name": "Moulconfig",
    "description": "A library for creating config GUIs.",
    "entrypoints": {
        "main": [
            "io.github.notenoughupdates.moulconfig.test.FabricMain"
        ]
    },
    "accessWidener": "moulconfig.accesswidener",
    "custom": {
        "modmenu": {
            "badges": [
                "library"
            ]
        }
    },
    "depends": {
        "fabric-api": ">=${fapi}",
        "fabricloader": ">=${floader}",
        "minecraft": "${minecraft}"
    }
}
